# Lines marked "# REQUIRED" cannot be empty — the app will fail to start
# (env validation via @t3-oss/env-core) or docker-compose will refuse to boot.

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public base URL (e.g. https://your-app.example.com). Used for password-reset links.
APP_BASE_URL=

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. Local dev: postgres://postgres:dev@localhost:5432/signsalesiq
DATABASE_URL=
# Optional: managed Postgres (e.g. DO). If set, takes precedence over DATABASE_URL.
# If set, TLS verification is disabled to accommodate DO's self-signed CA.
DO_DATABASE_URL=

# REQUIRED for docker-compose (interpolated into DATABASE_URL for the app service).
# Avoid the chars @ / : in the password — they break URL parsing.
POSTGRES_PASSWORD=dev
POSTGRES_USER=postgres
POSTGRES_DB=signsalesiq

# ── Sessions ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
# REQUIRED. Must start with "sk_". Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint signing secret
# Local testing: stripe listen --forward-to localhost:5000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────────
# Choose one provider: set RESEND_API_KEY for Resend, or SMTP_PASS for SMTP.
# EMAIL_PROVIDER can be "auto" (default), "resend", or "smtp".
EMAIL_PROVIDER=auto

# Resend (https://resend.com → API Keys)
RESEND_API_KEY=

# SMTP — set SMTP_PASS to enable. Host defaults to smtp0001.neo.space if blank.
SMTP_HOST=smtp0001.neo.space   # SMTP server host (587 STARTTLS / 465 SSL)
SMTP_PORT=587
SMTP_USER=                     # SMTP login (defaults to SMTP_FROM if blank)
SMTP_PASS=                     # REQUIRED to enable SMTP sending
SMTP_FROM=                     # From address (defaults to SMTP_USER)

# ── AI Services ───────────────────────────────────────────────────────────────
# Direct Google / Vertex key (for use outside Replit)
VERTEX_API_KEY=
GOOGLE_API_KEY=
# Replit AI proxy (used when running on Replit)
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Adobe Firefly (optional)
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=

# ── Object Storage ────────────────────────────────────────────────────────────
# DigitalOcean Spaces
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_REGION=nyc3

# ── Replit (optional — only needed when running inside Replit) ────────────────
REPL_ID=
REPLIT_DOMAINS=
ISSUER_URL=
DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# ── SSO / integrations ────────────────────────────────────────────────────────
SIGNSUITEIQ_SSO_SECRET=

# ── Seed / dev ────────────────────────────────────────────────────────────────
# Passwords for seeded demo accounts (dev only — never commit real values)
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# Set to "true" to force a full re-seed even if data already exists
FORCE_SEED=

# ── Observability ─────────────────────────────────────────────────────────────
# Injected by CI/CD for the /api/health endpoint
GIT_SHA=
# Sentry DSN — leave empty to disable error tracking
SENTRY_DSN=
